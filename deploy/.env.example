# Copy to deploy/.env and adjust. .env is git-ignored; never commit real secrets.

# --- PostgreSQL (docker-compose.dev.yml) ---
POSTGRES_DB=kalora
POSTGRES_USER=kalora
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Mailpit: local mail catcher (development only) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- API (read by ASP.NET Core; "__" maps to ":" in configuration keys) ---
# Must match the PostgreSQL values above. For local `dotnet run` prefer
#   dotnet user-secrets set "ConnectionStrings:Default" "<value>" --project backend/src/Kalora.Api
ConnectionStrings__Default=Host=localhost;Port=5432;Database=kalora;Username=kalora;Password=change-me
# Public origin of the web app, used for links in e-mails.
App__PublicBaseUrl=http://localhost:4200
# Secret for the signed links in customer mails (at least 32 characters). Generate with: openssl rand -base64 48
# Changing it invalidates all links already sent.
App__ManageTokenSecret=change-me-to-a-long-random-secret

# --- Mail (SMTP). Development uses Mailpit via appsettings.Development.json; production needs a real server. ---
Mail__FromAddress=noreply@example.com
Mail__FromName=Kalora
Mail__Smtp__Host=localhost
Mail__Smtp__Port=1025
# None | StartTls | SslOnConnect
Mail__Smtp__Security=None
Mail__Smtp__User=
Mail__Smtp__Password=
