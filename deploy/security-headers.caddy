# Security headers for the reverse proxy (Caddy) that serves the web app and forwards /api to the API.
# Import it in the site block:   import security_headers
# The API sets its own, stricter headers on everything under /api (see Kalora.Api/Http/SecurityHeadersMiddleware.cs);
# this snippet covers the files of the web app and the pages it serves.
#
# Content-Security-Policy of the web app:
#   - script-src 'self'  : no inline scripts, no eval. The production build has none (index.html carries no inline script).
#   - style-src 'unsafe-inline' : Angular and Angular Material put component styles and style attributes into the page while it runs.
#     This is the one place where the policy is looser than it could be; a nonce handed out per request (Angular's ngCspNonce) would
#     close it but needs the proxy to rewrite index.html on every request.
#   - img-src data:      : the QR code of the two-factor setup arrives as a data: URL.
#   - fonts, icons and scripts are all served from the own origin: no external CDN, no Google Fonts.
(security_headers) {
	@app not path /api/*
	header @app {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}
}
